@{
    ViewData["Title"] = "Начало";
}

<style>
    :root {
        --purple: #472950;
        --lilac: #DDC3E0;
        --satin: #F1A8B2;
        --apricot: #FFEBE1;
        --plum: #78201B;
    }

    body {
        font-family: Montserrat,system-ui,sans-serif;
        color: var(--purple);
        background: var(--apricot);
    }

    h1, h2, h3, .brand {
        font-family: Georgia,'Times New Roman',serif;
    }

    .navbar {
        background: var(--apricot);
    }

    .navbar-brand img {
        height: 36px;
    }

    .nav-link {
        color: var(--purple);
    }

    .btn-ink {
        background: var(--purple);
        color: var(--apricot);
        border-radius: 0;
        padding: .75rem 1.5rem;
        border: 2px solid var(--purple);
    }

        .btn-ink:hover {
            background: var(--apricot);
            border-color: var(--purple);
            color: var(--purple);
        }

    .btn-line {
        border: 2px solid var(--purple);
        border-radius: 0;
        padding: .7rem 1.5rem;
        color: var(--purple);
    }

        .btn-line:hover {
            background: var(--purple);
            color: var(--apricot);
        }

    .hero h1 {
        font-size: clamp(2.6rem,6vw,4.8rem);
        line-height: 1;
        font-weight: 600;
    }

    /* shelf animation */
    .shelf {
        background: var(--lilac);
        padding: 1.5rem 0 0;
        position: relative;
        overflow: hidden;
        user-select: none;
        touch-action: pan-y;
        cursor: grab;
    }

        .shelf.dragging {
            cursor: grabbing;
        }

    .books {
        position: relative;
        height: 330px;
        perspective: 1200px;
        border-bottom: 8px solid var(--purple);
    }

    .book {
        position: absolute;
        left: 0;
        bottom: 0;
        transform-style: preserve-3d;
    }

        .book .spine, .book .cover {
            position: absolute;
            top: 0;
            left: 0;
            height: 100%;
            backface-visibility: hidden;
        }

        .book .spine {
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            font: 600 .78rem/1 Montserrat,sans-serif;
            letter-spacing: .06em;
            writing-mode: vertical-rl;
            white-space: nowrap;
            overflow: hidden;
        }

        .book .cover {
            width: var(--cover-w);
            transform-origin: left center;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 1.2rem 1rem;
            box-shadow: 0 10px 28px rgba(71,41,80,.4);
        }

    .cover .ct {
        font: 600 1.35rem/1.1 Georgia,'Times New Roman',serif;
    }

    .cover .ca {
        font-size: .8rem;
        opacity: .85;
    }

    .shelf-caption {
        background: var(--purple);
        color: var(--apricot);
        padding: .9rem 1.1rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
    }

        .shelf-caption .t {
            font: 600 1.05rem Georgia,'Times New Roman',serif;
        }

        .shelf-caption .a {
            font-size: .85rem;
            color: var(--lilac);
        }

        .shelf-caption .btn {
            background: var(--satin);
            color: var(--purple);
            border-radius: 0;
            font-weight: 600;
            white-space: nowrap;
        }

            .shelf-caption .btn:hover {
                background: var(--apricot);
            }

    .arrows button {
        background: transparent;
        border: 2px solid var(--purple);
        color: var(--purple);
        width: 44px;
        height: 44px;
    }

        .arrows button:hover {
            background: var(--purple);
            color: var(--apricot);
        }

    .feature {
        border-left: 4px solid var(--c);
        padding-left: 1.1rem;
    }

        .feature h3 {
            font-size: 1.35rem;
        }

    .dark {
        background: var(--purple);
        color: var(--apricot);
    }

        .dark .muted {
            color: var(--lilac);
        }

    /* ---------- CTA с илюстрация ---------- */
    .book-cta {
        max-width: 1200px;
        margin: 0 auto;
        min-height: 440px;
        padding: 2rem 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--lilac) url('/images/BookIllustration.svg') center/cover no-repeat;
        container-type: inline-size;
    }

    .book-cta__text {
        background: var(--apricot);
        border: 3px solid var(--purple);
        padding: 2rem 1.5rem;
        max-width: 420px;
        text-align: center;
    }

        .book-cta__text h2 {
            font-size: 1.9rem;
            line-height: 1.1;
            margin-bottom: .75rem;
        }

        .book-cta__text p {
            margin-bottom: 1.25rem;
        }

    .full-bleed {
        width: 100vw;
        position: relative;
        left: 50%;
        margin-left: -50vw;

     @@media (min-width: 992px) {
        /* илюстрацията е 16:9, а текстът се мери спрямо нея, затова остава точно в книгата */
        .book-cta {
            aspect-ratio: 16/9;
            min-height: 0;
            padding: 0;
            display: block;
            position: relative;
            background-size: 100% 100%;
        }

        .book-cta__text {
            position: absolute;
            left: 35.85%;
            top: 39%;
            width: 28.3%;
            height: 53%;
            background: none;
            border: 0;
            padding: 0;
            max-width: none;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
        }

            .book-cta__text h2 {
                font-size: 2.6cqw;
                margin-bottom: 1.2cqw;
            }

            .book-cta__text p {
                font-size: 1.25cqw;
                margin-bottom: 1.6cqw;
            }

            .book-cta__text .btn {
                font-size: 1.2cqw;
                padding: .7cqw 1.6cqw;
            }
    }

    footer {
        background: var(--satin);
        color: var(--purple);
    }

        footer a {
            color: inherit;
        }

    :focus-visible {
        outline: 3px solid var(--satin);
        outline-offset: 2px;
    }
</style>

<header class="hero py-4 py-lg-5">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-5">
                <h1>Всяка книга<br>си има място.</h1>
                <p class="lead my-4">Качи книгите си като PDF, подреди ги на собствен рафт и ги отвори от различни устройства.</p>
                <div class="d-flex flex-wrap gap-3">
                    <a href="/register" class="btn btn-ink">Качи първата си книга</a>
                    <a href="#kak" class="btn btn-line">Как работи</a>
                </div>
            </div>

            <!-- shelf besides -->
            <div class="col-lg-7">
                <div class="shelf" id="shelf" aria-label="Рафт с книги – плъзни, за да избереш книга">
                    <div class="books" id="books"></div>
                </div>
                <div class="shelf-caption">
                    <div><div class="t" id="capTitle"></div><div class="a" id="capAuthor"></div></div>
                    <div class="d-flex align-items-center gap-2">
                        <a href="#" class="btn btn-sm" id="capOpen">Отвори PDF</a>
                    </div>
                </div>
                <div class="arrows d-flex gap-2 mt-3">
                    <button id="prev" aria-label="Предишна книга">&larr;</button>
                    <button id="next" aria-label="Следваща книга">&rarr;</button>
                </div>
            </div>
        </div>
    </div>
</header>

<section id="vazmozhnosti" class="py-5">
    <div class="container py-lg-4">
        <h2 class="mb-5 display-6">Всичко за библиотеката ти на едно място</h2>
        <div class="row g-5">
            <div class="col-md-6 col-lg-3">
                <div class="feature" style="--c:var(--satin)">
                    <h3>Качване</h3><p>Добави книга с корица, заглавие и автор. PDF файлът се качва заедно с нея.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="feature" style="--c:var(--lilac)">
                    <h3>Редактиране</h3><p>Смени корицата, поправи заглавието или замени PDF файла, когато поискаш.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="feature" style="--c:var(--plum)">
                    <h3>Изтриване</h3><p>Махни книга от рафта с едно натискане. Преди това те питаме, за да не изтриеш нещо по грешка.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="feature" style="--c:var(--purple)">
                    <h3>Четене</h3><p>Отвори PDF-а директно в сайта или го свали, за да го четеш без интернет.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section id="kak" class="dark full-bleed py-5">
    <div class="container py-lg-4">
        <h2 class="mb-5 display-6">Три стъпки до подреден рафт</h2>
        <div class="row g-5">
            <div class="col-md-4"><h3 class="h4">1. Създай профил</h3><p class="muted">Нужни са ти само имейл и парола.</p></div>
            <div class="col-md-4"><h3 class="h4">2. Качи книга</h3><p class="muted">Избери PDF, добави корица и заглавие. Книгата се появява на рафта ти.</p></div>
            <div class="col-md-4"><h3 class="h4">3. Прелиствай и чети</h3><p class="muted">Плъзни рафта, избери книга и тя се завърта към теб с корицата напред.</p></div>
        </div>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <div class="book-cta">
            <div class="book-cta__text">
                <h2>Остави книгите си да се подредят.</h2>
                <p>Безплатно за първите ти книги.</p>
                <a href="/register" class="btn btn-ink">Създай рафт</a>
            </div>
        </div>
    </div>
</section>

<script>
    /* трябва да налеем тук книги от базата данни като я направим */
    const items = [
        { t: 'Тихите стаи', a: 'Мария Георгиева', c: '#F1A8B2', f: '#472950', pdf: '#' },
        { t: 'Лилав час', a: 'Иван Петров', c: '#DDC3E0', f: '#472950', pdf: '#' },
        { t: 'Сол и канела', a: 'Елена Димова', c: '#78201B', f: '#FFEBE1', pdf: '#' },
        { t: 'Нощен влак', a: 'Борис Стоянов', c: '#472950', f: '#FFEBE1', pdf: '#' },
        { t: 'Кайсиева градина', a: 'Ана Колева', c: '#FFEBE1', f: '#78201B', pdf: '#' },
        { t: 'Писма до лятото', a: 'Георги Николов', c: '#A5527A', f: '#FFEBE1', pdf: '#' },
        { t: 'Малки бури', a: 'Десислава Иванова', c: '#8E5A9A', f: '#472950', pdf: '#' },
        { t: 'Дървета и дим', a: 'Петър Андреев', c: '#2E1A36', f: '#DDC3E0', pdf: '#' },
        { t: 'Празна лавица', a: 'Силвия Томова', c: '#8E3B46', f: '#FFEBE1', pdf: '#' }
    ];

    const wrap = document.getElementById('books'), shelf = document.getElementById('shelf');
    const capT = document.getElementById('capTitle'), capA = document.getElementById('capAuthor'), capO = document.getElementById('capOpen');
    const clamp = (v, a, b) => Math.min(b, Math.max(a, v));
    const last = items.length - 1;
    const GAP = 6;
    let SPINE_W = 34, COVER_W = 200, target = 3, pos = 3, running = false, lastShown = -1;

    const books = items.map(it => {
        const b = document.createElement('div');
        b.className = 'book';
        b.innerHTML = `<div class="spine" style="background:${it.c};color:${it.f}">${it.t}</div>
            <div class="cover" style="background:${it.c};color:${it.f}"><div class="ct">${it.t}</div><div class="ca">${it.a}</div></div>`;
        wrap.appendChild(b);
        return b;
    });

    function size() {
        COVER_W = clamp(wrap.clientWidth * 0.36, 140, 220);
        books.forEach(b => b.style.setProperty('--cover-w', COVER_W + 'px'));
    }

    function draw() {
        const ts = books.map((_, i) => clamp(1 - Math.abs(i - pos), 0, 1));
        const widths = ts.map(t => SPINE_W + (COVER_W - SPINE_W) * t);
        let x = 0;
        const lefts = widths.map(w => { const l = x; x += w + GAP; return l; });
        const i0 = Math.floor(pos), i1 = Math.min(i0 + 1, last), f = pos - i0;
        const c0 = lefts[i0] + widths[i0] / 2, c1 = lefts[i1] + widths[i1] / 2;
        const offset = wrap.clientWidth / 2 - (c0 + (c1 - c0) * f);

        books.forEach((b, i) => {
            const t = ts[i], h = 78 + 22 * t + (i % 3) * 3 * (1 - t);   // лека разлика във височините
            b.style.width = widths[i] + 'px';
            b.style.height = h + '%';
            b.style.transform = `translateX(${lefts[i] + offset}px)`;
            b.style.zIndex = Math.round(t * 10);
            b.children[1].style.transform = `rotateY(${-90 * (1 - t)}deg)`;   // корица
            b.children[0].style.opacity = 1 - t;                              // гръб
        });

        const cur = Math.round(pos);
        if (cur !== lastShown) {
            lastShown = cur;
            capT.textContent = items[cur].t; capA.textContent = items[cur].a; capO.href = items[cur].pdf;
        }
    }

    function loop() {
        pos += (target - pos) * 0.12;
        if (Math.abs(target - pos) < 0.001) { pos = target; running = false; }
        draw();
        if (running) requestAnimationFrame(loop);
    }
    function kick() { if (!running) { running = true; requestAnimationFrame(loop); } }
    function set(v) { target = clamp(v, 0, last); kick(); }

    document.getElementById('next').onclick = () => set(Math.round(target) + 1);
    document.getElementById('prev').onclick = () => set(Math.round(target) - 1);
    shelf.addEventListener('wheel', e => {
        if (Math.abs(e.deltaX) > Math.abs(e.deltaY) || e.shiftKey) { e.preventDefault(); set(target + (e.deltaX || e.deltaY) / 300); }
    }, { passive: false });
    shelf.addEventListener('keydown', e => { if (e.key === 'ArrowRight') set(Math.round(target) + 1); if (e.key === 'ArrowLeft') set(Math.round(target) - 1); });
    shelf.tabIndex = 0;

    let startX = null, startT = 0, moved = false;
    shelf.addEventListener('pointerdown', e => { startX = e.clientX; startT = target; moved = false; });
    window.addEventListener('pointermove', e => {
        if (startX === null) return;
        if (Math.abs(e.clientX - startX) > 5) { moved = true; shelf.classList.add('dragging'); }
        if (moved) set(startT - (e.clientX - startX) / 110);
    });
    window.addEventListener('pointerup', () => {
        if (startX === null) return;
        startX = null; shelf.classList.remove('dragging');
        if (moved) set(Math.round(target));
    });
    shelf.addEventListener('click', e => {
        if (moved) return;
        const i = books.indexOf(e.target.closest('.book'));
        if (i >= 0) set(i);
    });
    window.addEventListener('resize', () => { size(); draw(); });

    size(); draw();
</script>
