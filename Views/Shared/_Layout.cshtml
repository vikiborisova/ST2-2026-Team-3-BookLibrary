<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BookLibrary</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BookLibrary.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-md py-3">
            <div class="container">
               <a class="navbar-brand" asp-controller="Home" asp-action="Index">
    <img src="~/images/logo.png" alt="Shelfio">
</a>
                <button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#nav" aria-label="Меню"><span class="navbar-toggler-icon"></span></button>
                <div class="collapse navbar-collapse" id="nav">
                    <ul class="navbar-nav ms-auto align-items-md-center gap-md-3">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Начална страница</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Регистрация</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Books" asp-action="Index">Добави книга</a></li
                        <li class="nav-item"><a class="btn btn-ink" href="/прф">Профил</a></li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main> 
    </div>

  <footer class="py-4">
    <div class="container d-flex flex-wrap justify-content-between align-items-center gap-2 small">
        <a asp-controller="Home" asp-action="Index" class="footer-brand">
            <img src="~/images/logo.png" alt="Shelfio">
        </a>
        <span>&copy; 2026 Shelfio. Всички права запазени.</span>
        
    </div>
</footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
