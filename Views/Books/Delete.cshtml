@model BookLibrary.Models.Book

@{
    ViewData["Title"] = "Изтриване на книга";
}

<div class="narrow">
    <div class="page-head">
        <h2 style="color:var(--plum)">Изтриване на книга</h2>
    </div>

    <div class="form-card">
        <p class="lead mb-4">Сигурни ли сте, че искате да изтриете това заглавие от вашия рафт?</p>

        <dl class="row g-3 mb-0">
            <dt class="col-sm-3">Заглавие</dt>
            <dd class="col-sm-9 mb-0"><strong>@Model.Title</strong></dd>

            <dt class="col-sm-3">Автор</dt>
            <dd class="col-sm-9 mb-0">@Model.Author</dd>

            <dt class="col-sm-3">Жанр</dt>
            <dd class="col-sm-9 mb-0">@Model.Genre</dd>

            <dt class="col-sm-3">Година</dt>
            <dd class="col-sm-9 mb-0">@Model.Year</dd>
        </dl>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <div class="form-actions">
                <button type="submit" class="btn btn-remove">Да, изтрий</button>
                <a asp-action="Index" class="btn btn-more">Отказ</a>
            </div>
        </form>
    </div>
</div>