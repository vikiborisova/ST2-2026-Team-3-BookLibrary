@model IEnumerable<BookLibrary.Models.Book>

@{
    ViewData["Title"] = "Книги";
}

<h2>Библиотека с книги</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Добави нова книга</a>
</p>

<!-- Форма за търсене и филтриране по жанр -->
<form method="get" asp-action="Index" class="row g-3 mb-4">
    <div class="col-md-5">
        <input type="text" name="search" value="@ViewData["CurrentSearch"]" class="form-control" placeholder="Търси по заглавие или автор..." />
    </div>
    <div class="col-md-4">
        <select name="genre" class="form-select" asp-items="ViewBag.Genres">
            <option value="">-- Всички жанрове --</option>
        </select>
    </div>
    <div class="col-md-3">
        <button type="submit" class="btn btn-secondary w-100">Филтрирай</button>
    </div>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Заглавие</th>
            <th>Автор</th>
            <th>Жанр</th>
            <th>Година</th>
            <th>Описание</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Title</td>
                <td>@item.Author</td>
                <td>@item.Genre</td>
                <td>@item.Year</td>
                <td>@item.Description</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Редактирай</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Изтрий</a>
                </td>
            </tr>
        }
    </tbody>
</table>