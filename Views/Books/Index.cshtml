@model IEnumerable<BookLibrary.Models.Book>

@{
    ViewData["Title"] = "Книги";
}

<link rel="stylesheet" href="~/css/book-cards.css" asp-append-version="true" />

<h2 style="margin-bottom:15px">  Библиотека с книги</h2>

<p>
    <a asp-action="Create" class="btn-inkBooks" style="margin-bottom:15px; text-decoration:none;">Добави нова книга</a>
</p>

<!-- Форма за търсене и филтриране по жанр -->
<form method="get" asp-action="Index" class="row g-3 mb-4">
    <div class="col-md-5">
        <input type="text" name="search" value="@ViewData["CurrentSearch"]" class="form-control" placeholder="Търси по заглавие или автор..." />
    </div>
    <div class="col-md-4">
        <select name="genre" class="form-select" asp-items="ViewBag.Genres">
            <option value="">-- Всички жанрове --</option>
        </select>
    </div>
    <div class="col-md-3">
        <button type="submit" class="btn-lineBooks w-100">Филтрирай</button>
    </div>
</form>

@if (!Model.Any())
{
    <p class="text-muted">Няма намерени книги.</p>
}
else
{
    <section class="book-grid">
        @foreach (var item in Model)
        {
            <article class="book-card">
                <a asp-action="Details" asp-route-id="@item.Id" class="book" aria-label="@item.Title">
                    <div class="cover empty">@item.Title</div>
                </a>

                <h3 class="book-title">@item.Title</h3>

                <div class="book-actions">
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-more">Виж повече</a>
                    <div class="row-btns">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-edit">Редактирай</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-remove">Изтрий</a>
                    </div>
                </div>
            </article>
        }
    </section>
}
