@model BookLibrary.Models.Book

@{
    ViewData["Title"] = Model.Title;
}

<link rel="stylesheet" href="~/css/book-cards.css" asp-append-version="true" />

<div class="row g-4 align-items-start">
    <div class="col-md-4 d-flex justify-content-center">
        <div class="book">
            <div class="cover empty">@Model.Title</div>
        </div>
    </div>

    <div class="col-md-8">
        <h2 class="mb-1">@Model.Title</h2>
        <p class="text-muted fs-5 mb-3">@Model.Author</p>

        <p class="mb-2">
            <strong>Жанр:</strong> @Model.Genre
            &nbsp;&nbsp;<strong>Година:</strong> @Model.Year
        </p>

        <p class="mb-3">
            <strong>Статус:</strong>
            @if (Model.Status == "Прочетена")
            {
                <span class="badge bg-success">Прочетена</span>
            }
            else if (Model.Status == "В процес")
            {
                <span class="badge bg-warning text-dark">В процес</span>
            }
            else
            {
                <span class="badge bg-secondary">Ще чета</span>
            }
        </p>

        <h5>Описание</h5>
        <p style="max-width:70ch">@Model.Description</p>

        <div class="d-flex flex-wrap gap-2 mt-4">
            @if (!string.IsNullOrEmpty(Model.PdfPath))
            {
                <a href="@Model.PdfPath" target="_blank" class="btn btn-outline-danger">📄 Четете PDF</a>
            }
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Редактирай</a>
            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Изтрий</a>
            <a asp-action="Index" class="btn btn-outline-secondary">← Към библиотеката</a>
        </div>
    </div>
</div>
