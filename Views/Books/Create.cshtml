@model BookLibrary.Models.Book

@{
    ViewData["Title"] = "Добавяне на книга";
    var aiError = ViewData["AiError"] as string;
    var aiNotice = ViewData["AiNotice"] as string;
    var aiProvider = ViewData["AiProvider"] as string;
}

<div class="narrow">
    <div class="page-head justify-content-center">
        <h2 class="form-card-title">Добавяне на нова книга</h2>
    </div>

    <!-- AI: разпознаване от снимка на корицата -->
    <form asp-action="ExtractFromImage" method="post" enctype="multipart/form-data" class="form-card mb-4" id="extract-form">
        <h5 class="fw-bold mb-1">&#10024; Разпознай книгата от снимка</h5>
        <p class="small mb-3">Снимай корицата на книга по твой интересн. Google Gemini чете заглавието и автора, търси книгата в интернет и попълва формата по-долу. Преди запис ти проверяваш данните.</p>

        @if (!string.IsNullOrWhiteSpace(aiError))
        {
            <div class="alert alert-warning py-2 small" role="alert">@aiError</div>
        }
        @if (!string.IsNullOrWhiteSpace(aiNotice))
        {
            <div class="alert alert-info py-2 small" role="alert">@aiNotice</div>
        }
        @if (!string.IsNullOrWhiteSpace(aiProvider))
        {
            <div class="alert alert-success py-2 small" role="alert">
                Разпознато с @aiProvider. Прегледай и коригирай данните долу, после натисни „Запази“.
            </div>
        }

        <div class="row g-3 align-items-end">
            <div class="col-md-8">
                <label for="imageFile">Снимка на корицата (JPEG, PNG, WebP до 10 MB)</label>
                <input type="file" id="imageFile" name="imageFile" class="form-control"
                       accept="image/jpeg,image/png,image/webp" capture="environment" />
            </div>
            <div class="col-md-4">
                <button type="submit" id="extract-btn" class="btn btn-ink w-100">Разпознай</button>
            </div>
        </div>

        <img id="cover-preview" class="cover-preview d-none mt-3" alt="Преглед на снимката" />
    </form>

    <!-- Основна форма: добавя книгата на рафта -->
    <form asp-action="Create" method="post" enctype="multipart/form-data" class="form-card">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row g-4">
            <div class="col-md-6">
                <label asp-for="Title">Заглавие</label>
                <input asp-for="Title" class="form-control" required />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Author">Автор</label>
                <input asp-for="Author" class="form-control" required />
                <span asp-validation-for="Author" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Genre">Жанр</label>
                <select asp-for="Genre" class="form-select" asp-items="ViewBag.Genres" required>
                    <option value="">-- Изберете жанр --</option>
                </select>
            </div>
            <div class="col-md-6">
                <label asp-for="Year">Година на издаване</label>
                <input asp-for="Year" type="number" class="form-control" />
                <span asp-validation-for="Year" class="text-danger small"></span>
            </div>

            <div class="col-12">
                <label asp-for="Description">Описание</label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
            </div>

            <div class="col-md-6">
                <label asp-for="Status">Статус на четене</label>
                <select asp-for="Status" class="form-select">
                    <option value="Ще чета">Ще чета</option>
                    <option value="В процес">В процес</option>
                    <option value="Прочетена">Прочетена</option>
                </select>
            </div>
            <div class="col-md-6">
                <label for="pdfFile">Прикачи PDF файл</label>
                <input type="file" id="pdfFile" name="pdfFile" accept=".pdf" class="form-control" />
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-ink">Запази</button>
            <a asp-action="Index" class="btn btn-remove">Отказ</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const form = document.getElementById('extract-form');
            const input = document.getElementById('imageFile');
            const btn = document.getElementById('extract-btn');
            const preview = document.getElementById('cover-preview');

            // Преглед на избраната снимка
            input.addEventListener('change', () => {
                const file = input.files && input.files[0];
                if (!file) { preview.classList.add('d-none'); return; }
                preview.src = URL.createObjectURL(file);
                preview.classList.remove('d-none');
            });

            // Разпознаването отнема няколко секунди: показваме, че работи
            form.addEventListener('submit', () => {
                if (!input.files || input.files.length === 0) return;
                btn.disabled = true;
                btn.textContent = 'Разпознавам… (до 30 сек.)';
            });
        })();
    </script>
}