@model BookLibrary.Models.Book

@{
    ViewData["Title"] = "Добавяне на книга";
}

<h2>Добавяне на нова книга</h2>

<form asp-action="Create" method="post">
    <div class="form-group mb-3">
        <label asp-for="Title" class="control-label">Заглавие</label>
        <input asp-for="Title" class="form-control" required />
    </div>
    <div class="form-group mb-3">
        <label asp-for="Author" class="control-label">Автор</label>
        <input asp-for="Author" class="form-control" required />
    </div>
    <div class="form-group mb-3">
        <label asp-for="Genre" class="control-label">Жанр</label>
        <input asp-for="Genre" class="form-control" />
    </div>
    <div class="form-group mb-3">
        <label asp-for="Year" class="control-label">Година на издаване</label>
        <input asp-for="Year" type="number" class="form-control" />
    </div>
    <div class="form-group mb-3">
        <label asp-for="Description" class="control-label">Описание</label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
    </div>
    <button type="submit" class="btn btn-success">Запази</button>
    <a asp-action="Index" class="btn btn-secondary">Отказ</a>
</form>