@model BookLibrary.Models.Book

@{
    ViewData["Title"] = "Добавяне на книга";
}

<div class="narrow">
    <div class="page-head justify-content-center">
        <h2 class="form-card-title">Добавяне на нова книга</h2>
    </div>

    <form asp-action="Create" method="post" enctype="multipart/form-data" class="form-card">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row g-4">
            <div class="col-md-6">
                <label asp-for="Title">Заглавие</label>
                <input asp-for="Title" class="form-control" required />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Author">Автор</label>
                <input asp-for="Author" class="form-control" required />
                <span asp-validation-for="Author" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Genre">Жанр</label>
                <select asp-for="Genre" class="form-select" asp-items="ViewBag.Genres" required>
                    <option value="">-- Изберете жанр --</option>
                </select>
            </div>
            <div class="col-md-6">
                <label asp-for="Year">Година на издаване</label>
                <input asp-for="Year" type="number" class="form-control" />
                <span asp-validation-for="Year" class="text-danger small"></span>
            </div>

            <div class="col-12">
                <label asp-for="Description">Описание</label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
            </div>

            <div class="col-md-6">
                <label asp-for="Status">Статус на четене</label>
                <select asp-for="Status" class="form-select">
                    <option value="Ще чета">Ще чета</option>
                    <option value="В процес">В процес</option>
                    <option value="Прочетена">Прочетена</option>
                </select>
            </div>
            <div class="col-md-6">
                <label for="pdfFile">Прикачи PDF файл</label>
                <input type="file" id="pdfFile" name="pdfFile" accept=".pdf" class="form-control" />
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-ink">Запази</button>
            <a asp-action="Index" class="btn btn-remove">Отказ</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}