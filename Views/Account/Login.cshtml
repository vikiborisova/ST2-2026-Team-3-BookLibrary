@{
    ViewData["Title"] = "Вход";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-4">
        <h2 class="mb-3 text-center">🔐 Вход в системата</h2>

        <form asp-action="Login" method="post">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label class="form-label">Потребителско име</label>
                <input type="text" name="username" class="form-control" required />
            </div>

            <div class="mb-3">
                <label class="form-label">Парола</label>
                <input type="password" name="password" class="form-control" required />
            </div>

            <button type="submit" class="btn btn-primary w-100 mb-3">Вход</button>

            <div class="text-center">
                <a asp-action="Register">Нямате профил? Регистрирайте се тук</a>
            </div>
        </form>
    </div>
</div>
